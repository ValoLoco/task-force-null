[Unit]
Description=Special Forces AI squad (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=REPO_ROOT=%h/task-force-null
Environment=MISSION_SLUG=%i
# Oneshot readiness check. Linux systemd only (no restart loop).
ExecStart=/usr/bin/env bash -c 'cd "$REPO_ROOT" && exec ./scripts/start.sh'

[Install]
WantedBy=default.target