[Unit]
Description=Special Forces AI squad (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=REPO_ROOT=%h/task-force-null
Environment=MISSION_SLUG=%i
ExecStart=/bin/bash -c 'cd "$REPO_ROOT" && exec ./scripts/start.sh'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target